# Run from the PathSnap repository root. The API reads process environment variables.
# For Bash: copy to .env, then use: set -a; source .env; set +a
PATHSNAP_API_HOST=0.0.0.0
PATHSNAP_API_PORT=8000
PATHSNAP_BUNDLE_DIR=artifacts/releases/pathsnap-v0.1.2
PATHSNAP_PARTITION=student_test
PATHSNAP_DATA_ARCHIVE="../Provided_Material/Student folder.zip"
PATHSNAP_TRIP_REGISTRY=configs/student_registry.json
PATHSNAP_REFERENCE_CONFIG=configs/preprocessing.json
PATHSNAP_REFERENCE_SCORING=true
PATHSNAP_ENABLE_EVALUATOR_INFERENCE=false
PATHSNAP_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# UI on Laptop 2: replace localhost with Laptop 1's LAN address.
PATHSNAP_API_URL=http://localhost:8000
PATHSNAP_UI_HOST=0.0.0.0
PATHSNAP_UI_PORT=8501
